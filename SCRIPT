/* tabla persona*/
CREATE TABLE persona (
   idper INT GENERATED BY DEFAULT ON NULL AS IDENTITY START WITH 200 INCREMENT BY 1,
   dniper CHAR(8),
   nomper VARCHAR2(60),
   apeper VARCHAR2(80),
   emaper VARCHAR2(80),
   celper CHAR(9),
   tipper CHAR(1),
   fecnacper DATE,
   estper CHAR(1) DEFAULT 'A',
   CONSTRAINT per_pk PRIMARY KEY (idper)
);

/* tabla ventas*/
CREATE TABLE venta (
   idven INT GENERATED BY DEFAULT ON NULL AS IDENTITY START WITH 500 INCREMENT BY 1,
   fecven DATE,
   idcli  INT,
   idvend INT,
   tippagven CHAR(1),
   estven    CHAR(1) DEFAULT 'A',
   CONSTRAINT ven_pk PRIMARY KEY (idven)
);


/* tabla venta_detalle */
CREATE TABLE venta_detalle (
   idvendet INT GENERATED BY DEFAULT ON NULL AS IDENTITY START WITH 1000 INCREMENT BY 1,
   idven    INT,
   codprod  CHAR(3),
   canvendet INT,
   CONSTRAINT vdet_pk PRIMARY KEY (idvendet)
);


/* tabla categoria */
CREATE TABLE categoria (
   idcat INT GENERATED BY DEFAULT ON NULL AS IDENTITY START WITH 100 INCREMENT BY 1,
   nomcat VARCHAR2(60),
   CONSTRAINT cat_pk PRIMARY KEY (idcat)
);


/*tabla productos*/
CREATE TABLE producto (
   codprod CHAR(3),
   nompro  VARCHAR2(50),
   idcat   INT,
   prepro  NUMBER(8,2),
   stockpro INT,
   estpro  CHAR(1) DEFAULT 'A',
   CONSTRAINT pro_pk PRIMARY KEY (codprod)
);





/* relaciones*/

ALTER TABLE producto
   ADD CONSTRAINT pro_cat_fk FOREIGN KEY (idcat)
   REFERENCES categoria(idcat);

ALTER TABLE venta
   ADD CONSTRAINT ven_cli_fk FOREIGN KEY (idcli)
   REFERENCES persona(idper);


ALTER TABLE venta
   ADD CONSTRAINT ven_vend_fk FOREIGN KEY (idvend)
   REFERENCES persona(idper);

ALTER TABLE venta_detalle
   ADD CONSTRAINT vdet_ven_fk FOREIGN KEY (idven)
   REFERENCES venta(idven);

ALTER TABLE venta_detalle
   ADD CONSTRAINT vdet_pro_fk FOREIGN KEY (codprod)
   REFERENCES producto(codprod);

COMMIT;

